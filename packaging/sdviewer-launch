#!/bin/sh
# Menu launcher for sdviewer: logs to ~/.cache/sdviewer.log and shows a notification
# if the viewer exits with an error. Server selection happens inside the app
# (LAN discovery, recent servers, Settings > Automatic connect).
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}"
log="$cache_dir/sdviewer.log"

# SDL 2.26 picks X11 (Xwayland) by default; native Wayland works better under GNOME.
if [ -n "$WAYLAND_DISPLAY" ] && [ -z "$SDL_VIDEODRIVER" ]; then
    export SDL_VIDEODRIVER=wayland
fi

mkdir -p "$cache_dir"
"$(dirname "$0")/sdviewer" -v "$@" >"$log" 2>&1
rc=$?
if [ "$rc" -ne 0 ] && command -v notify-send >/dev/null; then
    notify-send -i video-display "SpaceDesk Linux" "La aplicación terminó con error (detalles en $log)"
fi
exit "$rc"
